  echo "----------------------------------------------------"
  echo "❌ Formato de commit inválido!"
  echo "Use o padrão: tipo(escopo): descrição"
  echo "Exemplos:"
  echo "  feat(frontend): adiciona botão de login"
  echo "  fix(backend): corrige bug de autenticação"
  echo "----------------------------------------------------"
  exit 1
fi